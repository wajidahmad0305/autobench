# AutoBench API keys — copy to `.env` and fill in. Never commit `.env`.

# Groq free/paid tier — powers C1/C2/C3 (all LangGraph configs) and the pilot.
GROQ_API_KEY=gsk_your_groq_key_here

# Google AI Studio — only needed if a Gemini config is re-enabled (not used in
# the current pilot).
GOOGLE_API_KEY=your_google_key_here

# Real OpenAI key — ONLY needed by the OpenAI Assistants adapter
# (autobench/adapters/openai_assistants_adapter.py). Groq is OpenAI-compatible
# for chat completions but NOT for the Assistants API, so that adapter cannot
# run through Groq. Leave blank if you are not running OpenAI Assistants
# trajectories; the pilot does not require it.
OPENAI_API_KEY=sk-your_openai_key_here

